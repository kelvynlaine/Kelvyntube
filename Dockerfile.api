FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN npm ci --workspace @kelvyntube/api --include-workspace-root && npm run generate -w @kelvyntube/db
ENV NODE_ENV=production
EXPOSE 10000
CMD ["npm", "run", "start", "-w", "@kelvyntube/api"]
