# ─────────────────────────────────────────────────────────────
# Kelvyn Tube — variables d'environnement (copier en `.env`)
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Base de données ──────────────────────────────────────────
DATABASE_URL="postgresql://kelvyn:kelvyn@localhost:5433/kelvyntube?schema=public"

# ── Redis (cache, vues, BullMQ, pub/sub notifications) ───────
REDIS_URL="redis://localhost:6380"

# ── API ──────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL="http://localhost:4000"
WEB_PUBLIC_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# ── Auth ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET="dev-access-secret-change-me-in-production-0123456789"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-in-production-9876543210"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30
COOKIE_DOMAIN="localhost"
COOKIE_SECURE=false

# OAuth Google (optionnel — laisser vide pour désactiver le bouton)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/oauth/google/callback"

# ── Emails (dev: Mailpit sur http://localhost:8025) ──────────
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Kelvyn Tube <no-reply@kelvyntube.local>"

# ── Stockage objet S3-compatible (MinIO en local, R2/B2 en prod) ──
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_ACCESS_KEY_ID="kelvyntube"
S3_SECRET_ACCESS_KEY="kelvyntube-secret"
S3_BUCKET="kelvyntube"
S3_FORCE_PATH_STYLE=true
# URL publique servie par le CDN (en local = MinIO direct)
CDN_PUBLIC_URL="http://localhost:9000/kelvyntube"

# ── Recherche ────────────────────────────────────────────────
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="kelvyntube-meili-master-key"

# ── Pipeline vidéo ───────────────────────────────────────────
# Chemin des binaires FFmpeg. "ffmpeg" suffit s'ils sont dans le PATH ;
# sinon indiquer le chemin absolu (ex. "$HOME/.local/bin/ffmpeg").
# Sans FFmpeg, le pipeline bascule en mode dégradé (cf. README).
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
# Répertoire de travail du transcodage
TRANSCODE_TMP_DIR="./tmp/transcode"
# Nombre de jobs de transcodage simultanés
TRANSCODE_CONCURRENCY=2
# Résolutions générées max (240p,360p,480p,720p,1080p,1440p,2160p)
MAX_RENDITION="1080p"

# ── Comptage de vues ─────────────────────────────────────────
# Durée minimale de visionnage (secondes) avant incrémentation
VIEW_MIN_WATCH_SECONDS=5
# Fenêtre de déduplication par (video, session) en secondes
VIEW_DEDUPE_WINDOW_SECONDS=1800
# Intervalle de flush Redis -> Postgres (ms)
VIEW_FLUSH_INTERVAL_MS=15000
