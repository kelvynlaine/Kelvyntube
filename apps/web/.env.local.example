NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
NEXT_PUBLIC_SITE_NAME="Kelvyn Tube"

# Affiche le bouton « Continuer avec Google » sur les écrans de connexion.
# À passer à "true" uniquement si GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET sont
# renseignés côté API — sinon les routes OAuth répondent 501.
NEXT_PUBLIC_GOOGLE_ENABLED=false
