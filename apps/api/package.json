    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.1",
    "@kelvyntube/db": "*",
    "@kelvyntube/shared": "*",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.5",
    "dotenv": "^16.4.7",
